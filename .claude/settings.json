{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git restore --staged:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checkout:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh auth status:*)",
      "Bash(gh repo view:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(node --version)",
      "Bash(npm run:*)",
      "Bash(python --version)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Test-Path:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(rm:*)",
      "PowerShell(Remove-Item:*)",
      "Bash(curl:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "Bash(npm install:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "PowerShell(Move-Item:*)",
      "PowerShell(Rename-Item:*)",
      "PowerShell(Copy-Item:*)",
      "PowerShell(Set-Content:*)",
      "Bash(find * -delete:*)",
      "Bash(find * -exec:*)",
      "Bash(git checkout -- :*)",
      "Bash(git checkout .)",
      "Bash(git checkout -f:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear)",
      "Bash(git push --delete:*)",
      "Bash(git push * --delete:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc:*)",
      "Bash(git filter-branch:*)",
      "Bash(git restore .:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "PowerShell(Stop-Computer:*)",
      "PowerShell(Restart-Computer:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.js\""
          }
        ]
      }
    ]
  }
}
